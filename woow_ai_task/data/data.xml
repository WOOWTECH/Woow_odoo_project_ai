<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="partner_category_project_ai_assistant" model="res.partner.category">
            <field name="name">Project AI Assistant</field>
        </record>

        <!-- Dispatcher: runs the AI replies in the cron process (triggered by every
             new job; the interval is the recovery of lost jobs). See models/ai_job.py. -->
        <record id="ir_cron_project_ai_run_jobs" model="ir.cron">
            <field name="name">Project AI: Run AI Replies</field>
            <field name="model_id" ref="model_woow_project_ai_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="priority">1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_project_ai_cleanup_logs" model="ir.cron">
            <field name="name">Project AI: Delete Old Call Logs and Jobs</field>
            <field name="model_id" ref="model_woow_project_ai_call_log"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <data noupdate="0">
        <!-- Removes the members who lost the task access by a change no trigger saw (a record rule, a
             commercial partner, ...); the triggers handle the usual changes at once. -->
        <record id="ir_cron_project_ai_sync_members" model="ir.cron">
            <field name="name">Project AI: Sync Task Chat Members</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="state">code</field>
            <field name="code">model._woow_project_ai_cron_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
