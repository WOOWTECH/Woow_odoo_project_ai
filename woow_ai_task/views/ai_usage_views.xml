<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woow_project_ai_usage_month_list" model="ir.ui.view">
        <field name="name">woow.project.ai.usage.month.list</field>
        <field name="model">woow.project.ai.usage.month</field>
        <field name="arch" type="xml">
            <list string="AI Usage" create="0" edit="0" delete="0">
                <field name="month"/>
                <field name="assistant_id"/>
                <field name="connection_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="scope_name" string="Scope" optional="hide"/>
                <field name="surface_tab"/>
                <field name="surface_type" optional="hide"/>
                <field name="replies_ok" sum="Total"/>
                <field name="replies_failed" sum="Total" optional="show"/>
                <field name="prompt_tokens" sum="Total" optional="hide"/>
                <field name="completion_tokens" sum="Total" optional="hide"/>
                <field name="total_tokens" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_woow_project_ai_usage_month_search" model="ir.ui.view">
        <field name="name">woow.project.ai.usage.month.search</field>
        <field name="model">woow.project.ai.usage.month</field>
        <field name="arch" type="xml">
            <search>
                <field name="assistant_id"/>
                <field name="connection_id"/>
                <field name="surface_tab"/>
                <field name="project_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_month" string="Month" context="{'group_by': 'month:month'}"/>
                    <filter name="group_assistant" string="AI Assistant" context="{'group_by': 'assistant_id'}"/>
                    <filter name="group_connection" string="AI Connection" context="{'group_by': 'connection_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_tab" string="Tab" context="{'group_by': 'surface_tab'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_woow_project_ai_usage_month" model="ir.actions.act_window">
        <field name="name">AI Usage</field>
        <field name="res_model">woow.project.ai.usage.month</field>
        <field name="view_mode">list</field>
        <field name="groups_id" eval="[Command.set([ref('base.group_system')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI reply yet</p>
            <p>Replies of the project AI assistants per month (UTC), project and tab (internal or customer AI
                chat): a reference for invoicing by hand. Kept permanently; the call logs are kept 30 days.</p>
        </field>
    </record>
</odoo>
