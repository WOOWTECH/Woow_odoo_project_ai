<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Switched off: a system administrator enables it (after the impact preview) in Project > Configuration >
         Project AI > AI Consultant Settings. noupdate + forcecreate="0": an upgrade never re-creates a deleted
         setting (nor clashes with a replacement an administrator created). -->
    <data noupdate="1">
        <record id="consult_profile_crm_lead" model="woow.project.ai.consult.profile" forcecreate="0">
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="enabled" eval="False"/>
            <field name="role_prompt">你是業務顧問：根據商機資料幫業務整理重點與下一步；不要承諾價格、折扣或交期。</field>
        </record>
    </data>
</odoo>
